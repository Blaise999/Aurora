# ── Base chain (MAINNET) ──
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org

# ── Contract (AuroraNft old collection — leave empty if not deployed) ──
NEXT_PUBLIC_AURORA_CONTRACT=

# ── Mint price fallback ──
NEXT_PUBLIC_MINT_PRICE=0.002

# ── AuroraCreator contract (user-mint NFTs) ──
NEXT_PUBLIC_CREATOR_CONTRACT=0xYOUR_CREATOR_CONTRACT_HERE

# ── WalletConnect ──
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# ── BuyCollector (code reads _CONTRACT not _ADDRESS) ──
NEXT_PUBLIC_BUY_COLLECTOR_CONTRACT=

# ── Admin / Treasury wallet ──
# MUST be the same address that deployed the AuroraCreator contract
# (contract owner via Ownable(msg.sender))
NEXT_PUBLIC_ADMIN_WALLET=0xYOUR_DEPLOYER_WALLET_HERE
NEXT_PUBLIC_TREASURY_WALLET=0xYOUR_DEPLOYER_WALLET_HERE

# ── Auth ──
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING

# ── Supabase ──
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx

# ── Notifications ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=aurora
NTFY_AUTH_TOKEN=

# ── Base RPC (server-side) ──
BASE_RPC_URL=https://mainnet.base.org

# ── Alchemy ──
ALCHEMY_API_KEY=your_alchemy_key

# ── Pushover ──
PUSHOVER_USER_KEY=your_pushover_user_key
PUSHOVER_APP_TOKEN=your_pushover_app_token
