# ── Base chain (MAINNET) ──
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org

# ── Contract (set after deploy) ──
NEXT_PUBLIC_AURORA_CONTRACT=0xYOUR_CONTRACT_ADDRESS_HERE
NEXT_PUBLIC_MINT_PRICE=0.002
NEXT_PUBLIC_CREATOR_CONTRACT=0xYOUR_CREATOR_CONTRACT_HERE

# ── WalletConnect ──
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# ── Auth ──
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING

# ── Supabase ──
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx

# ── Notifications ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=aurora
NTFY_AUTH_TOKEN=

# ── Base RPC (server-side) ──
BASE_RPC_URL=https://mainnet.base.org

# ── Admin ──
NEXT_PUBLIC_ADMIN_WALLET=0xYOUR_ADMIN_WALLET_ADDRESS

# ── Alchemy ──
ALCHEMY_API_KEY=your_alchemy_key
