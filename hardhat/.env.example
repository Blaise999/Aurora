# ── Deployer ──
DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key_here

# ── Treasury (admin wallet that receives all fees) ──
TREASURY_ADDRESS=0x_your_admin_wallet_here

# ── Contract Config ──
MINT_FEE_ETH=0.005
NFT_NAME=AuroraCreator
NFT_SYMBOL=ACREATE

# ── RPC URLs ──
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# ── BaseScan API Key (for contract verification) ──
# Get one at https://basescan.org/myapikey
BASESCAN_API_KEY=

# ── App URL (used for metadata URIs) ──
APP_BASE_URL=https://yourapp.vercel.app
